# Copy to .env.local for Next.js development and .env for Prisma CLI commands.
# Replace every placeholder using your provider's dashboard; never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Generate with: openssl rand -hex 32
RESEARCH_API_KEY="REPLACE_WITH_64_RANDOM_HEX_CHARACTERS"
CRON_SECRET="REPLACE_WITH_A_SEPARATE_64_RANDOM_HEX_SECRET"

APP_BASE_URL="http://localhost:3000"
DATA_MODE="fixture"

SERPAPI_API_KEY=""
SERPAPI_RIGHTS_PROFILE=""
FIRECRAWL_API_KEY=""
FIRECRAWL_SEARCH_ENABLED="false"
# Audit label for approved Firecrawl search snippet and page excerpt use; does not grant rights.
ENRICHMENT_RIGHTS_PROFILE=""

UPSTASH_REDIS_REST_URL="https://REPLACE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_UPSTASH_TOKEN"
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
QSTASH_DEV="true"

MAX_SERPAPI_CALLS_PER_DAY="25"
MAX_FIRECRAWL_CALLS_PER_DAY="5"
OBSERVATION_RETENTION_DAYS="30"
USAGE_RETENTION_DAYS="365"
